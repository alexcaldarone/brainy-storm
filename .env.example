# Copy this file to .env in the repository root. Never commit real keys.
# Required for browser recording and the Docker prototype.
GRADIUM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional settings for the alternative Python enrichment service (not in Compose).
DEFAULT_PROVIDER=auto

# Configure one or both providers. `auto` prefers Gemini, then OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=8001
